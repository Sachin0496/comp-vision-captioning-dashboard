  "headline": {
    "question": "Do better captions hallucinate less?",
    "answer": "On 500 held-out COCO images the object-aware model has the best BLEU-4 (18.03) and the lowest CHAIRs (23.64%), 25.68 percentage points below the global model's 49.32%. Across 1,500 pooled captions, higher sentence BLEU-4 is associated with fewer hallucinated objects (Spearman ρ = -0.327; image-cluster bootstrap 95% CI -0.386 to -0.268). At matched BLEU-4 in the 10-20 bin the models still range from 32.5% to 66.1% hallucinated object mentions, so BLEU overlap alone does not identify a grounded captioner.",
    "best_model": "object",
    "best_bleu4": 18.03,
    "best_chair_s": 23.64,
    "pooled_rho": -0.327,
    "pooled_p": 8.11e-39,
    "cluster_rho": -0.327,
